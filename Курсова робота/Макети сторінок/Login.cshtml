@page
@{
    Layout = null;
    ViewData["Title"] = "Вхід — KidSpace";
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true">
    <script src="~/js/login.js" asp-append-version="true" defer></script>
</head>
<body class="login-body">

    <main class="login-page">
        <div class="login-card">
            <div class="login-logo">Kid<span>Space</span></div>

            <h1>Увійти в акаунт</h1>
            <p>З поверненням до KidSpace!</p>

            <form id="loginForm" novalidate>
                <div class="login-field">
                    <label for="email">Електронна пошта</label>
                    <input type="email" id="email" placeholder="example@gmail.com" autocomplete="email">
                </div>

                <div class="login-field">
                    <label for="password">Пароль</label>
                    <div class="login-password-box">
                        <input type="password" id="password" placeholder="Введіть пароль" autocomplete="current-password">
                        <button type="button"
                                class="login-eye-btn"
                                data-target="password"
                                aria-label="Показати пароль"
                                aria-pressed="false">
                            <span class="login-eye-icon" aria-hidden="true"></span>
                        </button>
                    </div>
                </div>

                <p class="login-message" id="formMessage" role="alert" aria-live="polite"></p>

                <button type="submit" class="login-submit">Увійти</button>
            </form>

            <div class="login-bottom-link">
                Немає акаунту?
                <a href="/Register">Зареєструватися</a>
            </div>
        </div>

        <a href="/" class="login-back-home">← Повернутися на головну</a>
    </main>

</body>
</html>