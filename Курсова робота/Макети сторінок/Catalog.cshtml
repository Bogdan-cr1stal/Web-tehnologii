@page
@{
    Layout = null;
    ViewData["Title"] = "Каталог — KidSpace";
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Каталог дитячих іграшок та товарів KidSpace.">

    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/catalog.css" asp-append-version="true">
    <script src="~/js/catalog.js" asp-append-version="true" defer></script>
</head>

<body class="catalog-body">

    <header class="header">
        <div class="container header-content">

            <a href="/" class="logo">Kid<span>Space</span></a>

            <nav class="navigation" id="navigation" aria-label="Головна навігація">
                <a href="/">Головна</a>
                <a href="/Catalog" class="active">Каталог</a>
                <a href="/#categories">Категорії</a>
                <a href="/#brands">Бренди</a>
                <a href="/#about">Про нас</a>
            </nav>

            <div class="header-actions">
                <a href="/Login" class="login-link">Увійти</a>

                <a href="/Cart" class="cart-button">
                    <span class="cart-icon">🛒</span>
                    Кошик
                    <span class="cart-count" id="cartCount">0</span>
                </a>

                <button class="menu-toggle"
                        id="menuToggle"
                        type="button"
                        aria-label="Відкрити меню"
                        aria-expanded="false"
                        aria-controls="navigation">
                    ☰
                </button>
            </div>

        </div>
    </header>

    <main>

        <section class="catalog-search-bar">
            <div class="container catalog-search-inner">
                <div class="search-box">
                    <span class="search-icon" aria-hidden="true">⌕</span>
                    <input type="search"
                           id="searchInput"
                           placeholder="Пошук товарів у каталозі..."
                           aria-label="Пошук товарів у каталозі"
                           autocomplete="off">
                    <button type="button"
                            class="search-clear"
                            id="searchClear"
                            aria-label="Очистити пошук"
                            hidden>
                        ✕
                    </button>
                </div>

                <div class="products-count" id="productsCount">
                    36 товарів
                </div>
            </div>
        </section>

        <section class="catalog-section">
            <div class="container">

                <div class="catalog-header-row">
                    <div class="catalog-title">
                        <span class="section-label">НАШ АСОРТИМЕНТ</span>
                        <h1>Знайдіть щось особливе</h1>
                        <p>Іграшки, які дарують радість щодня</p>
                    </div>

                    <div class="sort-control" id="sortControl" data-value="default">
                        <button type="button"
                                class="sort-trigger"
                                id="sortTrigger"
                                aria-haspopup="listbox"
                                aria-expanded="false">
                            <span class="sort-label">Сортування:</span>
                            <span class="sort-current" id="sortCurrent">За замовчуванням</span>
                            <span class="sort-chevron" aria-hidden="true">⌄</span>
                        </button>

                        <ul class="sort-menu"
                            id="sortMenu"
                            role="listbox"
                            aria-label="Сортування товарів"
                            hidden>
                            <li class="sort-option is-selected" role="option" aria-selected="true" data-value="default">
                                За замовчуванням
                            </li>
                            <li class="sort-option" role="option" aria-selected="false" data-value="low">
                                Спочатку дешевші
                            </li>
                            <li class="sort-option" role="option" aria-selected="false" data-value="high">
                                Спочатку дорожчі
                            </li>
                            <li class="sort-option" role="option" aria-selected="false" data-value="name">
                                За назвою
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="catalog-layout">

                    <aside class="catalog-filter" aria-label="Фільтр категорій">

                        <div class="filter-heading">
                            <span aria-hidden="true">☷</span>
                            <h2>Категорії</h2>
                        </div>

                        <div class="filter-options">
                            <label class="filter-option">
                                <input type="radio" name="category" value="all" checked>
                                <span>Усі товари</span>
                            </label>
                            <label class="filter-option">
                                <input type="radio" name="category" value="М'які іграшки">
                                <span>М'які іграшки</span>
                            </label>
                            <label class="filter-option">
                                <input type="radio" name="category" value="Конструктори">
                                <span>Конструктори</span>
                            </label>
                            <label class="filter-option">
                                <input type="radio" name="category" value="Машинки">
                                <span>Машинки</span>
                            </label>
                            <label class="filter-option">
                                <input type="radio" name="category" value="Творчість">
                                <span>Творчість</span>
                            </label>
                            <label class="filter-option">
                                <input type="radio" name="category" value="Настільні ігри">
                                <span>Настільні ігри</span>
                            </label>
                            <label class="filter-option">
                                <input type="radio" name="category" value="Розвиваючі іграшки">
                                <span>Розвиваючі іграшки</span>
                            </label>
                            <label class="filter-option">
                                <input type="radio" name="category" value="Ляльки">
                                <span>Ляльки</span>
                            </label>
                            <label class="filter-option">
                                <input type="radio" name="category" value="Спортивні товари">
                                <span>Спортивні товари</span>
                            </label>
                            <label class="filter-option">
                                <input type="radio" name="category" value="Залізниці та треки">
                                <span>Залізниці та треки</span>
                            </label>
                            <label class="filter-option">
                                <input type="radio" name="category" value="Для найменших">
                                <span>Для найменших</span>
                            </label>
                            <label class="filter-option">
                                <input type="radio" name="category" value="Фігурки та герої">
                                <span>Фігурки та герої</span>
                            </label>
                            <label class="filter-option">
                                <input type="radio" name="category" value="Рольові ігри">
                                <span>Рольові ігри</span>
                            </label>
                        </div>

                        <div class="filter-info">
                            <span aria-hidden="true">💡</span>
                            <p>Обирайте іграшки, які розвивають уяву та творчість!</p>
